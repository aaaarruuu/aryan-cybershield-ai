# ARYAN CYBERSHIELD AI - example configuration.
# Copy to .env and edit. NEVER commit .env or real keys.

# --- required for Docker Compose ---
POSTGRES_PASSWORD=change-me-strong-db-password
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# --- general ---
APP_ENV=production            # 'development' enables /docs; 'production' hides it and refuses the default key
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:8080
UPLOAD_MAX_MB=10

# --- demo mode: deterministic analysis on bundled sample data, no paid APIs needed ---
DEMO_MODE=true

# --- optional live service (used when DEMO_MODE=false) ---
VIRUSTOTAL_API_KEY=

# --- local (non-Docker) development only ---
# DATABASE_URL=postgresql+psycopg://cybershield:cybershield@localhost:5432/cybershield
# CHROMA_PATH=./chroma_data
